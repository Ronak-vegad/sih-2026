# BIS Intelligent Assistant — Environment Variables
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to git.

# ── Required ──────────────────────────────────────────────────────
# Groq API key (used for LLM generation — LLaMA 3.1 8B)
# Get free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API key (used for embeddings)
# Get free key at: https://aistudio.google.com
GOOGLE_API_KEY=your_google_api_key_here

# ── Optional ──────────────────────────────────────────────────────
# Embedding provider: gemini (default) | openai | ollama
# EMBED_PROVIDER=gemini

# NVIDIA NIM key (only needed if switching to NVIDIA embeddings)
# NVIDIA_API_KEY=nvapi_your_key_here

# CORS origin for the deployed frontend (set this on Render)
# Example: ALLOW_ORIGIN=https://bis-rag.vercel.app
# Set to * for development (not recommended for production)
ALLOW_ORIGIN=http://localhost:3000

# Eval base URL (only needed when running eval/run_eval.py remotely)
# EVAL_BASE_URL=https://bis-chatbot.onrender.com

# Rate limit pause between Gemini embedding batches (seconds)
# Lower value = faster ingest but risks 429 errors on free tier
# EMBED_BATCH_SLEEP=65
