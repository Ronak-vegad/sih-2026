# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
*.spec

# ── Node / Frontend ───────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
.vite/

# ── Virtual environment ───────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Environment / Secrets (NEVER commit API keys) ─────────────
.env
!.env.example

# Generated / scraped data — keep index + DB in git so Render can use them
# Only exclude large raw PDFs and log files
data/pdfs/
# data/chroma_db/       ← committed: Render has no persistent disk (free plan)
# data/raw_documents.json ← committed: needed by /ingest admin endpoint
# data/qco_structured.db  ← committed: needed for structured QCO lookup
data/qco_structured.csv
data/*.log
data/supplement.log
data/scraper.log
data/failed_urls.log

# Keep the data/ directory itself tracked (for README reference)
!data/.gitkeep

# ── IDE & OS ──────────────────────────────────────────────────
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── Temp / scratch ────────────────────────────────────────────
inspect_data.py
*.tmp
*.bak
